rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções da hierarquia de acesso ──────────────────────────────────────
    // admin global > diretoria da construtora > engenheiro da obra > equipe.
    function isSignedIn() {
      return request.auth != null;
    }

    // Cadastrado SOMENTE via console/Firebase Admin — nenhum cliente escreve.
    function isGlobalAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/global_admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/global_admins/$(request.auth.uid)).data.get('isActive', true) == true;
    }

    // ── Admin global ─────────────────────────────────────────────────────────
    // Escrita apenas fora do app (console). Cada usuário só lê o próprio doc,
    // pro cache offline do GlobalAdminService.
    match /global_admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Construtoras ─────────────────────────────────────────────────────────
    // Leitura por autenticados (diretoria hidrata o contexto); escrita só
    // do admin global — ninguém cria/edita construtora pelo app comum.
    match /construtoras/{orgId} {
      allow read: if isSignedIn();
      allow write: if isGlobalAdmin();
    }

    // ── Dados de usuário ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isGlobalAdmin());
      allow update: if request.auth != null && request.auth.uid == userId;

      match /project_memberships/{membershipId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == userId || isGlobalAdmin());
      }

      // Vínculo de diretor: só o admin global concede/revoga. O próprio
      // usuário apenas lê (hidratação de sessão). Impede autopromoção.
      match /org_memberships/{membershipId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isGlobalAdmin());
        allow write: if isGlobalAdmin();
      }
    }

    // ── Gestão de projetos ────────────────────────────────────────────────────
    // Qualquer usuário autenticado pode ler projetos (necessário após consumir
    // o código de acesso para hidratar o contexto do projeto).
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // 'code' e 'orgId' imutáveis por usuário comum (achado em 2026-07-17,
      // ao construir a hierarquia de construtoras): sem esta trava, qualquer
      // autenticado poderia reescrever o 'code' do PRÓPRIO projeto pra igualar
      // o código de uma obra alheia — e, como /obras/{obraCode} hoje é aberto,
      // isso já não escala privilégio sozinho, mas passaria a ser uma porta de
      // sequestro assim que o lockdown de /obras/** (etapa 4b) mapear obraCode
      // → projectId através deste doc. Travar 'orgId' também impede se
      // autovincular a uma construtora que não é a sua. Admin global segue com
      // poder total (correção legítima de dado).
      allow update: if request.auth != null &&
        (isGlobalAdmin() ||
          (request.resource.data.code == resource.data.code &&
           request.resource.data.get('orgId', '') == resource.data.get('orgId', '')));
      allow delete: if isGlobalAdmin();

      match /access_codes/{codeId} {
        allow read, write: if request.auth != null;
      }

      match /pending_invites/{inviteId} {
        allow read, write: if request.auth != null;
      }

      // ⚠️ GAP CONHECIDO (achado em 2026-08-22 ao ligar o Controle de
      // estoque de equipamentos): sem esta regra, NENHUMA subcoleção do
      // ERP debaixo de /projects/{projectId}/ (cotacoes, requisicoes_compra,
      // pedidos_compra, despesas, equipamentos_estoque etc.) tinha regra
      // nenhuma — o Firestore nega por padrão, então todo `_mirror()` dos
      // serviços (Compras/Despesas/Estoque) falhava silenciosamente (o
      // catch só loga) e os dados nunca saíam do Hive local do
      // dispositivo. Mesmo nível de abertura já aceito para /obras/**
      // logo abaixo — lockdown por membership fica pro mesmo trabalho
      // futuro documentado ali.
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Mesmo gap para as subcoleções de Compras que ficam sob a construtora
    // (fornecedores, materiais_catalogo, centros_custo) — a regra de
    // `construtoras/{orgId}` acima cobre só o documento raiz.
    match /construtoras/{orgId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Permite collectionGroup queries em access_codes e pending_invites.
    match /{path=**}/access_codes/{codeId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/pending_invites/{inviteId} {
      allow read: if request.auth != null;
    }

    // ── Dados de obra (sync) ──────────────────────────────────────────────────
    // O sync usa /obras/{obraCode}/... como caminho raiz.
    //
    // ⚠️ GAP CONHECIDO (documentado em 2026-07-17): estas coleções ainda
    // aceitam leitura/escrita de qualquer autenticado. O lockdown por
    // membership exige testar com o emulador os fluxos legados (convite por
    // código, membership com id não determinístico) antes de apertar — senão
    // arrisca travar usuários reais em produção. Próximo passo do plano de
    // controle de usuários.
    match /obras/{obraCode} {
      allow read, write: if request.auth != null;

      match /inspections/{docId} {
        allow read, write: if request.auth != null;
      }

      match /services/{docId} {
        allow read, write: if request.auth != null;
      }

      match /companies/{docId} {
        allow read, write: if request.auth != null;
      }

      match /diaries/{docId} {
        allow read, write: if request.auth != null;
      }

      match /equipments/{docId} {
        allow read, write: if request.auth != null;
      }

      match /movements/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
